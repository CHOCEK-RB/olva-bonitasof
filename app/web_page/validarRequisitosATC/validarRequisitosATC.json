      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.reclamoVar ){",
        "\treturn {",
        "\t\t//map reclamoVar variable to expected task contract input",
        "\t\treclamoVarInput: {",
        "\t\t\tarticuloProhibido: $data.reclamoVar.articuloProhibido !== undefined ? $data.reclamoVar.articuloProhibido : null,",
        "\t\t\ttieneSeguro: $data.reclamoVar.tieneSeguro !== undefined ? $data.reclamoVar.tieneSeguro : false,",
        "\t\t\tflete: $data.reclamoVar.flete ? parseFloat($data.reclamoVar.flete) : 0.0",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
