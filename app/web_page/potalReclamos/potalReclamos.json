      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.reclamoVar ){",
        "\treturn {",
        "\t\t//map reclamoVar variable to expected task contract input",
        "\t\treclamoVarInput: {",
        "\t\t\tnumeroTracking: $data.reclamoVar.numeroTracking !== undefined ? $data.reclamoVar.numeroTracking : null,",
        "\t\t\tmotivoReclamo: $data.reclamoVar.motivoReclamo !== undefined ? $data.reclamoVar.motivoReclamo : null,",
        "\t\t\tvalorDeclarado: $data.reclamoVar.valorDeclarado !== undefined ? $data.reclamoVar.valorDeclarado : null,",
        "\t\t\tcorreoCliente: $data.reclamoVar.correoCliente !== undefined ? $data.reclamoVar.correoCliente : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
