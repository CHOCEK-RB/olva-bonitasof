        <defaultValue xmi:type="expression:Expression" xmi:id="_qcB3kGOmEfGB2508Od5TRQ" name="initRegistroEnvioVar()" content="def registroEnvioVar = new com.company.model.RegistroEnvio()&#xA;&#xA;registroEnvioVar.estadoEnvio = &quot;Recibido&quot;&#xA;registroEnvioVar.pagoConfirmado = false&#xA;&#xA;registroEnvioVar.fechaRegistro = processInput?.fechaRegistro ?: java.time.LocalDate.now()&#xA;registroEnvioVar.tipoPago = processInput?.tipoPago&#xA;&#xA;def nuevoCliente = new com.company.model.Cliente()&#xA;nuevoCliente.dni =      processInput?.remitente?.dni&#xA;nuevoCliente.nombres =      processInput?.remitente?.nombres&#xA;nuevoCliente.apellidos =      processInput?.remitente?.apellidos&#xA;nuevoCliente.telefono =      processInput?.remitente?.telefono&#xA;nuevoCliente.correo =      processInput?.remitente?.correo&#xA;&#xA;def nuevoPaquete = new com.company.model.Paquete()&#xA;nuevoPaquete.peso =      processInput?.datosPaquete?.peso&#xA;nuevoPaquete.largo =      processInput?.datosPaquete?.largo&#xA;nuevoPaquete.ancho =      processInput?.datosPaquete?.ancho&#xA;nuevoPaquete.alto =      processInput?.datosPaquete?.alto&#xA;nuevoPaquete.valorDeclarado =      processInput?.datosPaquete?.valorDeclarado&#xA;nuevoPaquete.direccionDestino =      processInput?.datosPaquete?.direccionDestino&#xA;&#xA;registroEnvioVar.remitente = nuevoCliente&#xA;registroEnvioVar.datosPaquete = nuevoPaquete&#xA;&#xA;return registroEnvioVar" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="com.company.model.RegistroEnvio"/>
      </data>
